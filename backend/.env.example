# Copy to .env. Every value below is optional; defaults live in app/config.py.
SKILLSYNC_DATABASE_URL=sqlite:///./skillsync.db
# SKILLSYNC_DATABASE_URL=postgresql+psycopg://skillsync:skillsync@localhost:5432/skillsync
SKILLSYNC_OLLAMA_URL=http://localhost:11434
SKILLSYNC_LLM_MODEL=llama3.1:8b
# Auth (a random secret is generated into backend/.jwt_secret when this is empty)
# SKILLSYNC_JWT_SECRET=
# SKILLSYNC_JWT_EXPIRE_MINUTES=480
# Optional: create an admin at start-up
# SKILLSYNC_ADMIN_EMAIL=admin@example.com
# SKILLSYNC_ADMIN_PASSWORD=
# SKILLSYNC_MODEL_BACKEND=real   # or light (no downloads; for trying the workflow)

# Scoring v2 (all have defaults in config.py)
# SKILLSYNC_BLIND_SCORING=true          score on text with identity details removed
# SKILLSYNC_RETRIEVAL_TOP_K=8           units kept per requirement before the reranker
# SKILLSYNC_HUB_MAX_REUSE=3             one evidence unit may back at most this many requirements
# SKILLSYNC_TIER_BAND_POINTS=2.0        candidates within this many points share a tier
# SKILLSYNC_OCR_DPI=300
# SKILLSYNC_OCR_PSM=4
# SKILLSYNC_OCR_MIN_CONFIDENCE=60
